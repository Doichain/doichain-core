# doichaind options for the DAA rehearsal (regtest params over a real network).
# All three VMs MUST share the same consensus switches.
# 60-s block target compresses the DigiShield dynamics 10x; DigiShield from block
# 20 with the reset window at 1f7fffff; -digishieldstrict enforces the headers-sync
# bound between peers as on mainnet.  RPC stays local (cookie auth, used by the
# miner and by doichain-status over SSH).
DOICHAIND_OPTS=-regtest -datadir=/var/lib/doichain -digishieldheight=20 -digishieldresetbits=1f7fffff -digishieldstrict=1 -powtargetspacing=60 -listen=1 -port=18444 -rpcport=18443 -dnsseed=0 -discover=0 -natpmp=0 -fallbackfee=0.0002 -printtoconsole=0
# Filled in by the orchestrator once the other VMs' host:port pairs are known,
# e.g. DOICHAIND_PEERS=-addnode=1.2.3.4:40123 -addnode=5.6.7.8:40456
DOICHAIND_PEERS=
